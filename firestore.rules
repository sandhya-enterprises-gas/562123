rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Inquiry Validation Helper
    function isValidInquiry(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.brand is string && data.brand.size() <= 100 &&
             data.quantity is number && data.quantity > 0 && data.quantity <= 1000 &&
             data.location is string && data.location.size() <= 120 &&
             data.status in ['new', 'contacted', 'closed'] &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Order Validation Helper
    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.orderNumber is string && data.orderNumber.size() <= 64 &&
             data.brand is string && data.brand.size() <= 100 &&
             data.quantity is number && data.quantity > 0 && data.quantity <= 500 &&
             data.deliveryArea is string && data.deliveryArea.size() <= 150 &&
             data.status in ['pending', 'confirmed', 'dispatched', 'delivered', 'cancelled'] &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Applicant Validation Helper
    function isValidApplicant(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 120 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.area is string && data.area.size() <= 120 &&
             data.workType in ['full_time', 'part_time', 'agency_franchise'] &&
             data.status in ['pending', 'reviewed', 'approved'] &&
             data.appliedAt is string && data.appliedAt.size() <= 64;
    }

    // Rate Notice Validation Helper
    function isValidRateNotice(data) {
      return data.bharat19kgApprox is number &&
             data.bharat47kgApprox is number &&
             data.gogasApprox is number &&
             data.lastUpdated is string && data.lastUpdated.size() <= 64;
    }

    // Global Safety Net Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection document for boot validation
    match /test/{testId} {
      allow read: if true;
    }

    // Authenticated User Profiles
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create: if isValidId(userId);
      allow update: if isValidId(userId);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Official Verification OTPs & Tokens
    match /verification_otps/{otpId} {
      allow read: if isValidId(otpId);
      allow create, update: if isValidId(otpId);
      allow delete: if isSignedIn();
    }

    // Rate Inquiries Collection
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow read: if isValidId(inquiryId);
      allow update: if isValidId(inquiryId) && isValidInquiry(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn();
    }

    // LPG Cylinder Orders Collection
    match /orders/{orderId} {
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow read: if isValidId(orderId);
      allow update: if isValidId(orderId) && isValidOrder(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn();
    }

    // Distributor & Delivery Partner Applicants
    match /applicants/{applicantId} {
      allow create: if isValidId(applicantId) && isValidApplicant(incoming());
      allow read: if isValidId(applicantId);
      allow update: if isValidId(applicantId) && isValidApplicant(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().appliedAt == existing().appliedAt;
      allow delete: if isSignedIn();
    }

    // Daily Rate Notices
    match /rates/{rateId} {
      allow read: if isValidId(rateId);
      allow write: if isValidId(rateId) && isValidRateNotice(incoming());
    }
  }
}
