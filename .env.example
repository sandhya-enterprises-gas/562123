# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Optional Google Maps Platform API key (or free Maps Demo Key)
# Used for rendering interactive Google Maps and Advanced Markers.
VITE_GOOGLE_MAPS_API_KEY=""

# RESEND_API_KEY: Optional free transactional email API key from Resend (resend.com)
# Used for sending real OTPs and password reset emails with zero DLT/SMS costs (3000 free emails/month).
RESEND_API_KEY=""

# EMAILJS_SERVICE_ID / EMAILJS_TEMPLATE_ID / EMAILJS_PUBLIC_KEY: EmailJS integration
# Alternative zero-cost email service for OTP verification.
EMAILJS_SERVICE_ID="service_31jj6yq"
EMAILJS_TEMPLATE_ID="template_sjy2r1b"
EMAILJS_PUBLIC_KEY="mq2CSZgr-vlXBFP1"
VITE_EMAILJS_SERVICE_ID="service_31jj6yq"
VITE_EMAILJS_TEMPLATE_ID="template_sjy2r1b"
VITE_EMAILJS_PUBLIC_KEY="mq2CSZgr-vlXBFP1"
